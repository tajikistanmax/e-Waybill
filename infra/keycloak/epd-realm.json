{
  "realm": "epd",
  "enabled": true,
  "registrationAllowed": false,
  "sslRequired": "external",
  "passwordPolicy": "length(12) and notUsername and notEmail and passwordHistory(3)",
  "bruteForceProtected": true,
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "enabledEventTypes": ["LOGIN", "LOGIN_ERROR", "LOGOUT", "LOGOUT_ERROR"],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "attributes": {
    "frontendUrl": "http://localhost:8180"
  },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"email\",\"displayName\":\"${email}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"rma\",\"displayName\":\"РМА\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]}},{\"name\":\"organizationRma\",\"displayName\":\"РМА организации\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]}}],\"unmanagedAttributePolicy\":\"ADMIN_EDIT\"}"
          ]
        }
      }
    ]
  },
  "roles": {
    "realm": [
      { "name": "DISPATCHER", "description": "Диспетчер (Танзимгар)" },
      { "name": "DOCTOR", "description": "Медицинский работник (Духтур)" },
      { "name": "MECHANIC", "description": "Механик — контролёр техсостояния" },
      { "name": "COMPANY_ADMIN", "description": "Администратор перевозчика — компания и все её филиалы" },
      { "name": "BRANCH_ADMIN", "description": "Администратор филиала перевозчика — только свой филиал" },
      { "name": "SYSTEM_ADMIN", "description": "Администратор системы (ГУП ЦЦТО)" },
      { "name": "MINTRANS_ANALYST", "description": "Аналитик Минтранса — надзор по всем организациям (только чтение)" },
      { "name": "INSPECTOR", "description": "Инспектор дорожного контроля" },
      { "name": "ACCOUNTANT", "description": "Бухгалтер (Муҳосиб) — подтверждение оплаты" },
      { "name": "DRIVER", "description": "Водитель (Ронанда) — просмотр своих ПЛ и предъявление QR" },
      { "name": "FUEL_STATION", "description": "Пункт выдачи топлива (Нуқтаи додани сӯзишворӣ) — учёт фактической выдачи" },
      { "name": "API_INTEGRATOR", "description": "Агрегатор/интегратор (ЧУРА, НЕРУ) — scoped API-доступ" }
    ]
  },
  "clients": [
    {
      "clientId": "epd-web",
      "name": "ЭПД РТ — веб-клиент",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": ["http://localhost:3000/*", "http://localhost:3001/*", "http://localhost:3002/*", "http://10.10.22.81:3000/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:3001", "http://localhost:3002", "http://10.10.22.81:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "rma",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "rma",
            "claim.name": "rma",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "organization_rma",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "organizationRma",
            "claim.name": "organization_rma",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "epd-aggregator",
      "name": "ЭПД РТ — API агрегаторов (ЧУРА/НЕРУ)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "epd_aggregator_dev_secret",
      "protocolMappers": [
        {
          "name": "api-integrator-role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-role-mapper",
          "consentRequired": false,
          "config": {
            "role": "API_INTEGRATOR"
          }
        }
      ]
    },
    {
      "clientId": "epd-provisioner",
      "name": "ЭПД РТ — провижининг логинов сотрудников (master-data → Keycloak Admin API)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "epd_provisioner_dev_secret"
    }
  ],
