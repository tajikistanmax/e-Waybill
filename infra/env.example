# Шаблон infra/.env для стенда «е-Роҳхат» (пилот / промышленная эксплуатация).
# Скопируйте:  cp env.example .env   и заполните. Файл .env в git НЕ попадает.
# Порядок выкладки и проверка — infra/DEPLOY.md; предпроверка — sh preflight.sh.
#
# Генерация значений (на сервере):
#   пароль / секрет:      openssl rand -base64 24
#   ключ шифрования:      openssl rand -base64 32
#   ключ подписи QR:      docker run --rm node:22-alpine node -e "const c=require('crypto');const k=c.generateKeyPairSync('ec',{namedCurve:'P-256'}).privateKey.export({format:'jwk'});k.kid='epd-qr-'+Date.now();console.log(JSON.stringify(k))"
#
# !!! MEDDATA_ENCRYPTION_KEY, QR_SIGNING_KEY и BACKUP_ENCRYPTION_KEY задаются ОДИН РАЗ.
#     Смена ключа медданных делает сохранённые медпоказатели нечитаемыми, ключа QR — выданные
#     QR непроверяемыми, ключа копий — старые копии нерасшифровываемыми. Храните копию ключей
#     отдельно от сервера (сейф / хранилище секретов).

# ---------------------------------------------------------------- адрес стенда
# IP или имя, по которому пользователи открывают платформу. На него выпускается
# самоподписанный сертификат (если нет настоящего в nginx/certs) и строится ссылка QR.
EPD_TLS_HOST=10.10.29.70
# Адрес портала проверки в QR печатных бланков (по умолчанию https://EPD_TLS_HOST:8443). Задавать,
# только если портал открыт под другим именем, например https://verify.rohkhat.tj.
# PUBLIC_BASE_URL=https://10.10.29.70:8443

# ---------------------------------------------------------------- база и хранилище
# Если база уже создана со старым паролем, смена здесь пароль не меняет — нужен ALTER USER.
DB_USER=epd
DB_PASSWORD=
MINIO_USER=epd
MINIO_PASSWORD=

# ---------------------------------------------------------------- служебные учётки
# Обязателен: без него compose не стартует (служба путевых листов ходит в справочники).
SERVICE_ACCOUNT_PASSWORD=
# Внешний агрегатор (канал /api/v1/aggregator). Пусто — учётка не создаётся.
AGGREGATOR_PASSWORD=
# Начальный администратор для установки С НУЛЯ (боевой сервер: обязателен — других учёток не будет).
# При первом входе попросит сменить пароль и подключить второй фактор. Остальных пользователей
# он заводит в «Управление → Пользователи» и «Доступы».
EPD_AUTH_ADMIN_USERNAME=
EPD_AUTH_ADMIN_PASSWORD=
# ТОЛЬКО для демо-стенда: перенести демо/QA-учётки из infra/keycloak/epd-realm.json (пароли в
# репозитории!). На боевом сервере оставить пустым.
AUTH_BOOTSTRAP_REALM_FILE=

# ---------------------------------------------------------------- ключи (задаются один раз)
MEDDATA_ENCRYPTION_KEY=
QR_SIGNING_KEY=
BACKUP_ENCRYPTION_KEY=
# APP_KEY старой системы «Роҳхат» (строка APP_KEY=base64:… из её .env) — чтобы старые бумажные QR
# /qrcode/{тип}/{id} открывали проверку перенесённого листа. Пусто — старые QR не проверяются.
LEGACY_APP_KEY=
# Секрет вебхука платёжного шлюза: не короче 16 символов (иначе служба не запустится).
PAYMENT_WEBHOOK_SECRET=

# ---------------------------------------------------------------- необязательные
# HSTS — ТОЛЬКО с сертификатом удостоверяющего центра:  EPD_HSTS=max-age=31536000
EPD_HSTS=
# Внешний сервер тайлов карты для CSP (если задан NEXT_PUBLIC_MAP_TILES_URL).
EPD_CSP_IMG_EXTRA=
# Резервное копирование: время (местное) и срок хранения, дней.
BACKUP_TIME=00:00
BACKUP_RETENTION_DAYS=30
TZ=Asia/Dushanbe
# Единая платформа Минтранса (e-Transport): stub — имитация; http + адрес — при подключении.
UNIFIED_PLATFORM_MODE=stub
UNIFIED_PLATFORM_URL=
