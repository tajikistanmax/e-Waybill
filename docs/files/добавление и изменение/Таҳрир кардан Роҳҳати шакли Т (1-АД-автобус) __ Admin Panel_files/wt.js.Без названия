$(document).on("select2:select", 'select[data-repeatable-input-name="fuel_id"]', function () {
    const fuel = $(this).val();
    const parking = $('select[name="parking_id"]').val();
    const tbl = $('input[name="tbl"]').val();
    const id = $('input[name="id"]').val().length != 0 ? $('input[name="id"]').val() : 0;
    //console.log(id);
    const elm = $(this);
    $.get("/api/parking_fuel_give/" + parking + "/" + fuel + "/" + tbl + "/" + id)
        .done(function (data) {
            const give = parseInt(data.given);
            elm.closest('.repeatable-element').find('[data-repeatable-input-name="fuel_given"]').val(give);
            $('input[data-repeatable-input-name="fuel_given"]').trigger('change');
        });
});

