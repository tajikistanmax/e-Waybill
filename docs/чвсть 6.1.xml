<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.nalog.ru/EPD/PL/Titul2"
           xmlns:tns="http://www.nalog.ru/EPD/PL/Titul2">

  <xs:element name="Титул2">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="ДатаОсмотра" type="xs:date" minOccurs="1" maxOccurs="1"/>
        <xs:element name="ВремяОсмотра" type="xs:time" minOccurs="1" maxOccurs="1"/>
        <xs:element name="Результат" minOccurs="1" maxOccurs="1">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="ГОДЕН"/>
              <xs:enumeration value="НЕ_ГОДЕН"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="МедицинскийРаботник" minOccurs="1" maxOccurs="1">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="ФИО" type="tns:ФИОТип" minOccurs="1" maxOccurs="1"/>
              <xs:element name="СНИЛС" type="tns:СНИЛСТип" minOccurs="1" maxOccurs="1"/>
              <xs:element name="Должность" type="xs:string" minOccurs="1" maxOccurs="1"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Лицензия" minOccurs="1" maxOccurs="1">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Номер" type="xs:string" minOccurs="1" maxOccurs="1"/>
              <xs:element name="ДатаВыдачи" type="xs:date" minOccurs="1" maxOccurs="1"/>
              <xs:element name="КемВыдана" type="xs:string" minOccurs="1" maxOccurs="1"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="ЭлектроннаяПодпись" type="tns:ПодписьТип" minOccurs="1" maxOccurs="1"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:simpleType name="ФИОТип">
    <xs:restriction base="xs:string">
      <xs:minLength value="5"/>
      <xs:maxLength value="100"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="СНИЛСТип">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{3}-[0-9]{3}-[0-9]{3} [0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="ПодписьТип">
    <xs:sequence>
      <xs:element name="ФИО" type="xs:string" minOccurs="1" maxOccurs="1"/>
      <xs:element name="ДатаПодписи" type="xs:dateTime" minOccurs="1" maxOccurs="1"/>
      <xs:element name="Сертификат" type="xs:string" minOccurs="1" maxOccurs="1"/>
      <xs:element name="Значение" type="xs:string" minOccurs="1" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>